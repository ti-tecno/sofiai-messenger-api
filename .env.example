# Copiar a .env (ignorado por git) y completar. No poner valores reales aquí.
# Si un valor lleva # o espacios, ponlo entre comillas (node --env-file).
PORT=
# Opcional: interfaz donde escuchar (127.0.0.1 = solo local / túnel SSH). Vacío = todas.
HOST=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Opcional: prefijo de las tablas del mensajero (solo [a-z0-9_], máx. 20), p. ej. msg_.
# Úsalo si la BD se comparte con otros sistemas. Vacío = sin prefijo. No cambiar con datos.
DB_TABLE_PREFIX=
# Llave de administración (>= 24 caracteres)
ADMIN_API_KEY=
# Token por defecto y siembra del canal "default"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_DEFAULT_COUNTRY=
# Opcional: HTTPS directo
SSL_KEY_PATH=
SSL_CERT_PATH=
# Opcional: teléfonos separados por comas; si se define, solo se envía a ellos
SEND_ALLOWLIST=
# Una por canal que no use WHATSAPP_TOKEN (el nombre va en channel.tokenEnv), p. ej.:
# WA_TOKEN_CEINVET=
